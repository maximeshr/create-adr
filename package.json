{
  "name": "create-adr",
  "version": "1.0.0",
  "description": "CLI to generate Architecture Decision Records",
  "license": "UNLICENSED",
  "type": "commonjs",
  "bin": {
    "create-adr": "bin/create-adr.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src bin *.config.ts *.config.cjs",
    "format": "oxfmt --write src bin *.config.ts *.config.cjs",
    "format:check": "oxfmt --check src bin *.config.ts *.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.62.0",
    "tsdown": "^0.16.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
