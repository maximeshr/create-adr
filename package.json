{
  "name": "create-adr",
  "version": "1.0.0",
  "description": "CLI to generate Architecture Decision Records",
  "license": "MIT",
  "bin": {
    "create-adr": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "changeset": "changeset",
    "check:version": "node scripts/check-version.mjs",
    "version-packages": "changeset version",
    "release": "vp pack && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.12.2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
